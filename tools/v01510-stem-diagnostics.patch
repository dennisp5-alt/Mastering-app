+    private static int countInformative(List<Probe> probes) {
+        int count = 0;
+        for (Probe p : probes) if (p.informative) count++;
+        return count;
+    }
+
+    /**
+     * Select up to eight nonoverlapping active sections as additional witnesses.
+     * A witness counts only if it independently agrees with the mix in the
+     * original envelope, signed polarity, lag and drift tests.
+     */
+    private static void addActivityProbes(StemResult result, FeatureSeries mix,
+                                          FeatureSeries stem, int common, int length) {
+        if (common < length * 3) return;
+        ArrayList<double[]> ranked = new ArrayList<>();
+        for (int i = 1; i <= 24; i++) {
+            double fraction = i / 25.0;
+            int centre = (int) Math.round(fraction * (common - 1));
+            int start = Math.max(MAX_LAG_WINDOWS,
+                    Math.min(common - length - MAX_LAG_WINDOWS, centre - length / 2));
+            if (start < MAX_LAG_WINDOWS || start + length + MAX_LAG_WINDOWS > common) continue;
+            double strongest = -180.0;
+            for (int j = start; j < start + length; j += 25) {
+                strongest = Math.max(strongest, stem.envelope[j]);
+            }
+            if (strongest < -75.0) continue; // essentially silent for this stem
+            ranked.add(new double[]{strongest, fraction, (start + 0.5 * length) * HOP_SECONDS});
+        }
+        ranked.sort((a,b) -> Double.compare(b[0], a[0]));
+        ArrayList<Double> used = new ArrayList<>();
+        for (Probe probe : result.probes) if (probe.informative) used.add(probe.positionSeconds);
+        for (double[] candidate : ranked) {
+            if (result.adaptiveProbesAttempted >= MAX_ADAPTIVE_PROBES
+                    || countInformative(result.probes) >= 3) break;
+            boolean near = false;
+            for (Double location : used) {
+                if (Math.abs(location - candidate[2]) < PROBE_SECONDS * 1.3) {
+                    near = true;
+                    break;
+                }
+            }
+            if (near) continue;
+            // Reserve every attempted location, including inconclusive ones,
+            // so repeated overlapping segments never inflate confidence.
+            used.add(candidate[2]);
+            Probe probe = measureProbe(mix, stem, common, length,
+                    candidate[1], "active section " + (result.adaptiveProbesAttempted + 1));
+            result.probes.add(probe);
+            result.adaptiveProbesAttempted++;
+            if (probe.informative) result.adaptiveProbesInformative++;
+        }
+    }

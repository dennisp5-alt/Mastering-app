--- patchcheck1510/app/src/main/java/com/dennis/aimasteringlab/StemDurationDiagnostics.java	1970-01-01 00:00:00.000000000 +0000
+++ next1510/app/src/main/java/com/dennis/aimasteringlab/StemDurationDiagnostics.java	2026-10-12 00:31:11.677531772 +0000
@@ -0,0 +1,58 @@
+package com.dennis.aimasteringlab;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.util.Locale;
+import org.json.JSONObject;
+
+/** Non-authorising explanation of small common end-of-song discrepancies. */
+final class StemDurationDiagnostics {
+    private StemDurationDiagnostics() {}
+
+    static JSONObject inspect(File mix, AnalysisResult analysis) throws Exception {
+        JSONObject out = new JSONObject();
+        double d = analysis.commonStemTailShortfallSeconds;
+        out.put("strict_duration_mismatches", analysis.stemDurationMismatchCount);
+        out.put("common_shortfall_seconds", d);
+        out.put("largest_absolute_delta_seconds", analysis.largestStemDurationDeltaSeconds);
+        out.put("policy", "Diagnostics only. Duration tolerances and stem-audio eligibility are NOT relaxed.");
+        if (d <= 0.0) {
+            out.put("assessment", analysis.stemDurationMismatchCount == 0
+                    ? "SAMPLE_ALIGNED_DURATION" : "DURATION_DIFFERENCE_UNVERIFIED");
+            return out;
+        }
+        if (d > 0.5) {
+            out.put("assessment", "COMMON_TAIL_SHORTFALL_TOO_LONG_TO_DISMISS");
+            return out;
+        }
+        try (WavFile.Reader reader = WavFile.open(new FileInputStream(mix))) {
+            long tailFrames = Math.max(1, Math.min(reader.info.frames,
+                    (long) Math.ceil(d * reader.info.sampleRate)));
+            reader.skipFrames(reader.info.frames - tailFrames);
+            float[][] buffer = new float[reader.info.channels][4096];
+            double squares = 0.0, peak = 0.0;
+            long n = 0;
+            int frames;
+            while ((frames = reader.readFrames(buffer, 4096)) > 0) {
+                for (int c = 0; c < reader.info.channels; c++) {
+                    for (int i = 0; i < frames; i++) {
+                        double v = buffer[c][i];
+                        if (!Double.isFinite(v)) throw new IOException("Invalid tail sample");
+                        squares += v * v;
+                        peak = Math.max(peak, Math.abs(v));
+                        n++;
+                    }
+                }
+            }
+            double rms = 20.0 * Math.log10(Math.max(1.e-12, Math.sqrt(squares / Math.max(1L,n))));
+            double peakDb = 20.0 * Math.log10(Math.max(1.e-12, peak));
+            out.put("original_missing_tail_rms_dbfs", rms);
+            out.put("original_missing_tail_peak_dbfs", peakDb);
+            out.put("assessment", rms <= -60.0 && peakDb <= -45.0
+                    ? "POSSIBLE_QUIET_TRAILING_TAIL_UNVERIFIED"
+                    : "AUDIBLE_REFERENCE_TAIL_MISSING_FROM_STEMS");
+        }
+        return out;
+    }
+}

diff -ruN '--exclude=RELEASE_NOTES_v0.15.9.md' patchcheck1510/tests/V01510StemDiagnosticsHarness.java next1510/tests/V01510StemDiagnosticsHarness.java
--- patchcheck1510/tests/V01510StemDiagnosticsHarness.java	1970-01-01 00:00:00.000000000 +0000
+++ next1510/tests/V01510StemDiagnosticsHarness.java	2026-10-12 00:31:43.027982158 +0000
@@ -0,0 +1,50 @@
+package com.dennis.aimasteringlab;
+
+import java.io.File;
+import java.io.FileInputStream;
+import org.json.JSONObject;
+
+/** Safety regression: adaptive witnesses cannot rehabilitate delayed stems. */
+public final class V01510StemDiagnosticsHarness {
+    static void require(boolean condition, String message) {
+        if (!condition) throw new AssertionError(message);
+    }
+    static AnalysisResult inspect(File mix, File zip) throws Exception {
+        AudioAnalyzer.Progress quiet = (name, progress) -> {};
+        AnalysisResult base = AudioAnalyzer.analyze(mix.getName(),
+                () -> new FileInputStream(mix), quiet);
+        base.stems.addAll(StemInventory.inspect(zip, quiet));
+        StemInventory.compareAgainstMix(base);
+        base.stemReconstruction = StemReconstruction.analyze(
+                () -> new FileInputStream(mix), base, zip, quiet);
+        base.stemAlignment = StemAlignmentValidator.analyze(
+                () -> new FileInputStream(mix), base, zip, quiet);
+        return base;
+    }
+    public static void main(String[] args) throws Exception {
+        File fixtures = new File(args[0]);
+        File mix = new File(fixtures,"StemFixtureMix.wav");
+        AnalysisResult good = inspect(mix, new File(fixtures,"StemFixtureSafe.zip"));
+        require(good.stemAlignment.stemsEvaluated == 2, "two stems inspected");
+        require(good.stemAlignment.secureStems > 0, "valid fixture wrongly rejected");
+        JSONObject duration = StemDurationDiagnostics.inspect(mix, good);
+        require("SAMPLE_ALIGNED_DURATION".equals(duration.getString("assessment")),
+                "exact sample duration not identified");
+        AnalysisResult bad = inspect(mix, new File(fixtures,"StemFixtureDelayed.zip"));
+        StemAlignmentValidator.StemResult late =
+                bad.stemAlignment.find("Electric Guitar.wav");
+        require(late != null && !late.secure && !late.analysisSecure,
+                "20-ms displaced stem was accepted by adaptive probes");
+        require(!StemTrustClassifier.classify(bad).audioDeltaAllowed,
+                "delayed stems became eligible for audio deltas");
+        // The diagnostic may recognize a trailing mismatch but must never waive it.
+        good.commonStemTailShortfallSeconds = 0.20;
+        JSONObject tail = StemDurationDiagnostics.inspect(mix, good);
+        require(tail.has("original_missing_tail_rms_dbfs"), "missing tail measurements");
+        require(tail.getString("policy").contains("NOT relaxed"),
+                "tail diagnosis must not alter safety gate");
+        System.out.println("V01510_STEM_DIAGNOSTICS_PASS good="
+                + good.stemAlignment.secureStems + " delayedRejected=true tail="
+                + tail.getString("assessment"));
+    }
+}
